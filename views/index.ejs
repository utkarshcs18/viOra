<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>viOra</title>
    <link rel="stylesheet" href="/css/index.css">
</head>
<body>

    <!-- Precise Wireframe Lines (Light Theme) -->
    <svg class="wireframe-lines">
        <line x1="0" y1="0" x2="100" y2="100" stroke="#e0e0e0" stroke-width="1" />
    </svg>

    <header class="top-bar">
        <!-- Profile & Now Playing Pill -->
        <div class="left-pill-container" style="display: flex; align-items: center; gap: 10px;">
            <!-- Profile moved to sidebar -->

            <div class="left-pill" id="nowPlayingPill">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                Now Playing
            </div>
        </div>

        <!-- Logo -->
        <div class="logo">viOra</div>

        <!-- Search -->
        <div class="right-pill-container">
            <div class="right-pill">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" id="searchInput" class="search-input" placeholder="Search...">
            </div>
        </div>
    </header>

    <div class="main-body">
        <nav class="sidebar">


            <div class="sidebar-item" id="topMusicIcon" title="Top Music">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
            </div>
            
            <div class="sidebar-item" id="playlistsIcon" title="Liked Songs">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            </div>
            <div class="sidebar-item" id="cameraIcon" title="Mood Sync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
            </div>
            
            <div class="sidebar-bottom-item profile-container" id="profileContainer" title="Profile" style="margin-top: auto;">
                <div id="profilePillBtn" style="cursor: pointer; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                <div class="profile-dropdown">
                    <% if (isAuthenticated) { %>
                        <p style="margin: 0; font-weight: bold; color: #333;"><%= userName %></p>
                        <p style="margin: 5px 0 15px 0; font-size: 12px; color: #777;"><%= userEmail %></p>
                        <a href="/api/auth/logout" style="color: #e74c3c; text-decoration: none; font-weight: 600; font-size: 14px;">Logout</a>
                    <% } else { %>
                        <a href="/login" style="color: #333; text-decoration: none; font-weight: 600; font-size: 14px;">Login / Signup</a>
                    <% } %>
                </div>
            </div>
            
            <div class="sidebar-bottom-item" id="creditIcon" title="Credit" style="margin-top: 0;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            </div>
        </nav>

        <main class="content-wrapper">
            <div class="gray-box" id="grayBox">
                <!-- Center Floating Icon (Trending) -->
                <div class="trending-icon" id="trendingIcon">
                    <svg style="width: 40px; height: 40px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                </div>

                <!-- Content Container for Grids -->
                <div id="dynamicContainer">
                    <div id="artistsSection" style="display: none;">
                        <h2 class="section-title">Top Artists</h2>
                        <div class="artists-row" id="artistsRow"></div>
                    </div>
                    
                    <h2 class="section-title" id="sectionTitle" style="margin-top: 16px;">Top Music</h2>
                    <div class="music-grid" id="musicGrid"></div>
                </div>

                <!-- Now Playing Container -->
                <div id="nowPlayingView">
                    <img id="npThumbnail" class="np-thumbnail" src="https://via.placeholder.com/300">
                    <div id="npTitle" class="np-title">No track playing</div>
                    <div id="npArtist" class="np-artist">-</div>
                    <div class="timeline-container">
                        <span class="time-label" id="currentTimeLabel">0:00</span>
                        <input type="range" id="progressBar" class="progress-bar" min="0" max="100" value="0" step="0.1">
                        <span class="time-label" id="totalTimeLabel">0:00</span>
                    </div>

                    <div class="np-controls">
                        <button class="np-btn" id="likeBtn">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        </button>
                        <button class="np-btn" onclick="playPreviousSong()">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="19 20 9 12 19 4 19 20"></polygon><line x1="5" y1="19" x2="5" y2="5"></line></svg>
                        </button>
                        <button class="np-btn np-play" id="playPauseBtn">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                        </button>
                        <button class="np-btn" onclick="playNextSong()">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
                        </button>
                        <button class="np-btn" onclick="toggleQueue()" style="margin-left: 20px;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                        </button>
                    </div>

                    <!-- User Queue Panel (Hidden by default) -->
                    <div id="queuePanel" style="display: none; position: absolute; right: 40px; top: 120px; width: 300px; max-height: 60vh; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(20px); border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.15); border: 1px solid rgba(255,255,255,0.5); flex-direction: column; overflow: hidden; z-index: 100;">
                        <div style="padding: 20px; border-bottom: 1px solid rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center;">
                            <h3 style="margin: 0; font-size: 18px; color: #111;">Up Next</h3>
                            <button onclick="toggleQueue()" style="background: none; border: none; cursor: pointer; color: #666;">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                        <div id="queueList" style="flex: 1; overflow-y: auto; padding: 10px;">
                            <!-- Queue items populated by JS -->
                        </div>
                    </div>
                </div>

                <!-- Camera Container -->
                <div id="cameraView">
                    <h2 class="section-title">Mood Sync</h2>
                    <video id="videoElement" autoplay muted></video>
                    <button class="mood-btn" id="startSyncBtn">Start Camera Sync</button>
                    <div id="moodOutput" style="margin-top: 15px; font-weight: bold; font-size: 18px; color: #1db954;"></div>
                </div>

            </div>
        </main>
    </div>

    <!-- Hidden YT Player -->
    <div id="yt-player" style="display: none;"></div>

    <script>
const isAuthenticated = "<%- isAuthenticated %>" === "true";
    </script>
    <script src="/js/index.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <script src="https://www.youtube.com/iframe_api"></script>
</body>
</html>
